{
	"name": "DFDIMRestaurantv2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "sourceDIMRESTAURANTDALLAS"
				},
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "sourceDIMRESTAURANTCHICAGO"
				},
				{
					"dataset": {
						"referenceName": "SF_Restaurant_v2",
						"type": "DatasetReference"
					},
					"name": "sourceMaxId"
				},
				{
					"dataset": {
						"referenceName": "SF_Restaurant_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimrestaurant"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SF_Restaurant_v2",
						"type": "DatasetReference"
					},
					"name": "sinkDALLAS",
					"rejectedDataLinkedService": {
						"referenceName": "BlobStgFoodInspection",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "union"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join2"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     jobid as string (uuid())",
				"}",
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDIMRESTAURANTDALLAS",
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          BUSINESS_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDIMRESTAURANTCHICAGO",
				"source(output(",
				"          MAXRESTAURANTSK as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     query: 'select NVL(MAX(RESTAURANT_SK),0) as MaxRestaurantSK FROM FOOD_SCHEMA.DIM_RESTAURANT_TEST',",
				"     format: 'query') ~> sourceMaxId",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimrestaurant",
				"sourceDIMRESTAURANTDALLAS derive(DI_JOD_ID = \"DallasJob\") ~> derivedColumn2",
				"sourceDIMRESTAURANTCHICAGO derive(DI_JOD_ID = \"ChicagoJob\") ~> derivedColumn3",
				"derivedColumn2, derivedColumn3 union(byName: true)~> union",
				"join2 select(mapColumn(",
				"          RESTAURANT_SK,",
				"          RESTAURANT_NAME = aggregate1@RESTAURANT_NAME,",
				"          STREET_ADDRESS = aggregate1@STREET_ADDRESS,",
				"          MAXRESTAURANTSK,",
				"          DI_JOD_ID,",
				"          DI_LOAD_DATE",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"union, sourceMaxId join(1==1,",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 aggregate(groupBy(RESTAURANT_NAME,",
				"          STREET_ADDRESS,",
				"          MAXRESTAURANTSK,",
				"          DI_JOD_ID),",
				"     CountRow = count(INSPECTION_ID)) ~> aggregate1",
				"aggregate1, sourcedimrestaurant join(aggregate1@RESTAURANT_NAME == sourcedimrestaurant@RESTAURANT_NAME",
				"     && aggregate1@STREET_ADDRESS == sourcedimrestaurant@STREET_ADDRESS,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"select1 keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(DI_LOAD_DATE = currentDate(),",
				"          RESTAURANT_SK = MAXRESTAURANTSK+rownum) ~> derivedColumn4",
				"derivedColumn4 select(mapColumn(",
				"          RESTAURANT_SK,",
				"          RESTAURANT_NAME,",
				"          STREET_ADDRESS,",
				"          DI_JOD_ID,",
				"          DI_LOAD_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     stageInsert: true,",
				"     mapColumn(",
				"          RESTAURANT_SK,",
				"          RESTAURANT_NAME,",
				"          STREET_ADDRESS,",
				"          DI_JOB_ID = DI_JOD_ID,",
				"          DI_LOAD_DATE",
				"     )) ~> sinkDALLAS"
			]
		}
	}
}