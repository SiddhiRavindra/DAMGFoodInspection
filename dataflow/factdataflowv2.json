{
	"name": "factdataflowv2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "sourcechicago"
				},
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "sourcedallas"
				},
				{
					"dataset": {
						"referenceName": "SF_Restaurant_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimrestaurant"
				},
				{
					"dataset": {
						"referenceName": "SF_Dimlocation_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimlocation"
				},
				{
					"dataset": {
						"referenceName": "SfDimDate",
						"type": "DatasetReference"
					},
					"name": "sourcedimdate"
				},
				{
					"dataset": {
						"referenceName": "SF_Violation_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimviolation"
				},
				{
					"dataset": {
						"referenceName": "SF_Inspection_v2_new",
						"type": "DatasetReference"
					},
					"name": "sourcediminspection"
				},
				{
					"dataset": {
						"referenceName": "SF_Fact_v2",
						"type": "DatasetReference"
					},
					"name": "sourcefactmax"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SF_Fact_v2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedChicago"
				},
				{
					"name": "derivedDallas"
				},
				{
					"name": "union1"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "join4"
				},
				{
					"name": "join5"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "join6"
				},
				{
					"name": "select2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "aggregate2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          STREET_ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcechicago",
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedallas",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimrestaurant",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as decimal(38,0),",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimlocation",
				"source(output(",
				"          DATE_SK as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_MONTH as string,",
				"          INSPECTION_YEAR as decimal(38,0),",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimdate",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimviolation",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcediminspection",
				"source(output(",
				"          MAXVIOLATIONSK as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     query: 'select NVL(MAX(INSPECTION_SK),0) as MaxViolationSK FROM FOOD_SCHEMA. FACT_INSPECTION_V2',",
				"     format: 'query') ~> sourcefactmax",
				"sourcechicago derive(DI_JOB_ID = \"ChicagoJob\") ~> derivedChicago",
				"sourcedallas derive(DI_JOB_ID = \"DallasJob\") ~> derivedDallas",
				"derivedChicago, derivedDallas union(byName: false)~> union1",
				"aggregate2, sourcedimrestaurant join(aggregate2@RESTAURANT_NAME == sourcedimrestaurant@RESTAURANT_NAME",
				"     && aggregate2@STREET_ADDRESS == sourcedimrestaurant@STREET_ADDRESS,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, sourcedimlocation join(ZIP_CODE == ZIPCODE",
				"     && aggregate2@CITY == sourcedimlocation@CITY",
				"     && aggregate2@STATE == sourcedimlocation@STATE",
				"     && aggregate2@LATITUDE == sourcedimlocation@LATITUDE",
				"     && aggregate2@LONGITUDE == sourcedimlocation@LONGITUDE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, sourcedimdate join(aggregate2@INSPECTION_DATE == sourcedimdate@INSPECTION_DATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3, sourcedimviolation join(aggregate2@VIOLATION_NUMBER == sourcedimviolation@VIOLATION_NUMBER",
				"     && aggregate2@VIOLATION_DESCRIPTION == sourcedimviolation@VIOLATION_DESCRIPTION,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join4, sourcediminspection join(aggregate2@INSPECTION_TYPE == sourcediminspection@INSPECTION_TYPE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"surrogateKey1 derive(DI_LOAD_DATE = currentDate(),",
				"          rownum = MAXVIOLATIONSK+rownum) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          RESTAURANT_NAME,",
				"          STREET_ADDRESS,",
				"          CITY,",
				"          STATE,",
				"          INSPECTION_DATE,",
				"          ZIP_CODE,",
				"          INSPECTION_TYPE,",
				"          VIOLATIONS,",
				"          LATITUDE,",
				"          LONGITUDE,",
				"          VIOLATION_COUNT,",
				"          VIOLATION_DESCRIPTION,",
				"          DI_JOB_ID,",
				"          VIOLATION_NUMBER,",
				"          INSPECTION_YEAR,",
				"          CountRow,",
				"          RESTAURANT_SK,",
				"          LOCATION_SK,",
				"          ZIPCODE,",
				"          INSPECTION_MONTH,",
				"          VIOLATION_SK,",
				"          MAXVIOLATIONSK,",
				"          INSPECTIONTYPE_SK,",
				"          DATE_SK,",
				"          rownum,",
				"          DI_LOAD_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select2 keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"join5, sourcefactmax join(1==1,",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"join6 select(mapColumn(",
				"          RESTAURANT_NAME = aggregate2@RESTAURANT_NAME,",
				"          STREET_ADDRESS = aggregate2@STREET_ADDRESS,",
				"          CITY = aggregate2@CITY,",
				"          STATE = aggregate2@STATE,",
				"          INSPECTION_DATE = aggregate2@INSPECTION_DATE,",
				"          ZIP_CODE,",
				"          INSPECTION_TYPE = aggregate2@INSPECTION_TYPE,",
				"          VIOLATIONS,",
				"          LATITUDE = aggregate2@LATITUDE,",
				"          LONGITUDE = aggregate2@LONGITUDE,",
				"          VIOLATION_COUNT,",
				"          VIOLATION_DESCRIPTION = aggregate2@VIOLATION_DESCRIPTION,",
				"          DI_JOB_ID = aggregate2@DI_JOB_ID,",
				"          VIOLATION_NUMBER = aggregate2@VIOLATION_NUMBER,",
				"          INSPECTION_YEAR = aggregate2@INSPECTION_YEAR,",
				"          CountRow,",
				"          RESTAURANT_SK,",
				"          LOCATION_SK,",
				"          ZIPCODE,",
				"          INSPECTION_DATE = sourcedimdate@INSPECTION_DATE,",
				"          INSPECTION_MONTH,",
				"          VIOLATION_SK,",
				"          MAXVIOLATIONSK,",
				"          INSPECTIONTYPE_SK,",
				"          DATE_SK",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1 aggregate(groupBy(CITY,",
				"          VIOLATION_SK,",
				"          RESTAURANT_SK,",
				"          rownum,",
				"          DI_LOAD_DATE,",
				"          LOCATION_SK,",
				"          STATE,",
				"          INSPECTIONTYPE_SK,",
				"          DATE_SK,",
				"          DI_JOB_ID),",
				"     VIOLATION_COUNT = count(VIOLATION_COUNT)) ~> aggregate1",
				"union1 aggregate(groupBy(LICENSE_NUMBER,",
				"          RESTAURANT_NAME,",
				"          STREET_ADDRESS,",
				"          CITY,",
				"          STATE,",
				"          INSPECTION_DATE,",
				"          ZIP_CODE,",
				"          INSPECTION_TYPE,",
				"          VIOLATIONS,",
				"          LATITUDE,",
				"          LONGITUDE,",
				"          VIOLATION_COUNT,",
				"          VIOLATION_DESCRIPTION,",
				"          DI_JOB_ID,",
				"          VIOLATION_NUMBER,",
				"          INSPECTION_YEAR),",
				"     CountRow = count(INSPECTION_ID)) ~> aggregate2",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          INSPECTION_SK as decimal(38,0),",
				"          RESTAURANT_SK as decimal(38,0),",
				"          DATE_SK as decimal(38,0),",
				"          LOCATION_SK as decimal(38,0),",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          VIOLATION_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true,",
				"     mapColumn(",
				"          INSPECTION_SK = rownum,",
				"          RESTAURANT_SK,",
				"          DATE_SK,",
				"          LOCATION_SK,",
				"          INSPECTIONTYPE_SK,",
				"          VIOLATION_SK,",
				"          VIOLATION_COUNT,",
				"          CITY,",
				"          STATE,",
				"          DI_JOB_ID,",
				"          DI_LOAD_DATE",
				"     )) ~> sink1"
			]
		}
	}
}