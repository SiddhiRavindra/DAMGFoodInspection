{
	"name": "factdataflowv2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "sourcechicago"
				},
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "sourcedallas"
				},
				{
					"dataset": {
						"referenceName": "SF_Restaurant_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimrestaurant"
				},
				{
					"dataset": {
						"referenceName": "SF_Dimlocation_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimlocation"
				},
				{
					"dataset": {
						"referenceName": "SfDimDate",
						"type": "DatasetReference"
					},
					"name": "sourcedimdate"
				},
				{
					"dataset": {
						"referenceName": "SF_Violation_v2",
						"type": "DatasetReference"
					},
					"name": "sourcedimviolation"
				},
				{
					"dataset": {
						"referenceName": "SF_Inspection_v2_new",
						"type": "DatasetReference"
					},
					"name": "sourcediminspection"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedChicago"
				},
				{
					"name": "derivedDallas"
				},
				{
					"name": "union1"
				},
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "join4"
				},
				{
					"name": "join5"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          STREET_ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcechicago",
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedallas",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimrestaurant",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as decimal(38,0),",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimlocation",
				"source(output(",
				"          DATE_SK as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_MONTH as string,",
				"          INSPECTION_YEAR as decimal(38,0),",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimdate",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimviolation",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcediminspection",
				"sourcechicago derive(DI_JOB_ID = \"ChicagoJob\") ~> derivedChicago",
				"sourcedallas derive(DI_JOB_ID = \"DallasJob\") ~> derivedDallas",
				"derivedChicago, derivedDallas union(byName: true)~> union1",
				"union1, sourcedimrestaurant join(union1@RESTAURANT_NAME == sourcedimrestaurant@RESTAURANT_NAME",
				"     && union1@STREET_ADDRESS == sourcedimrestaurant@STREET_ADDRESS,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, sourcedimlocation join(ZIP_CODE == ZIPCODE",
				"     && union1@CITY == sourcedimlocation@CITY",
				"     && union1@STATE == sourcedimlocation@STATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, sourcedimdate join(union1@INSPECTION_DATE == sourcedimdate@INSPECTION_DATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3, sourcedimviolation join(union1@VIOLATION_NUMBER == sourcedimviolation@VIOLATION_NUMBER",
				"     && union1@VIOLATION_DESCRIPTION == sourcedimviolation@VIOLATION_DESCRIPTION,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join4, sourcediminspection join(union1@INSPECTION_TYPE == sourcediminspection@INSPECTION_TYPE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"join5 derive(DI_LOAD_DATE = currentDate()) ~> derivedColumn1",
				"surrogateKey1 select(mapColumn(",
				"          CITY = union1@CITY,",
				"          STATE = union1@STATE,",
				"          VIOLATION_COUNT,",
				"          RESTAURANT_SK,",
				"          LOCATION_SK,",
				"          DATE_SK,",
				"          VIOLATION_SK,",
				"          INSPECTIONTYPE_SK,",
				"          rownum,",
				"          DI_JOB_ID = union1@DI_JOB_ID,",
				"          DI_LOAD_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1"
			]
		}
	}
}