{
	"name": "dataflowDallasUnified",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ParquetDallasSourceStg",
						"type": "DatasetReference"
					},
					"name": "sourceDallasUnified"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SnowflakeTableUnifiedStg",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumnDallas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          RecordID as long,",
				"          Restaurant_Name as string,",
				"          Inspection_Year as string,",
				"          Inspection_Type as string,",
				"          Inspection_Score as short,",
				"          Inspection_Date as date,",
				"          Street_Number as long,",
				"          Street_Name as string,",
				"          Street_Direction as string,",
				"          Street_Address as string,",
				"          Street_Unit as string,",
				"          Street_Type as string,",
				"          Zip_Code as integer,",
				"          City as string,",
				"          State as string,",
				"          Latitude as double,",
				"          Longitude as double,",
				"          Violation_Count as short,",
				"          Total_Violation_Points as short,",
				"          Location_Missing as string,",
				"          Violation_Description as string,",
				"          Violation_Number as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceDallasUnified",
				"sourceDallasUnified derive(sourcecity = 'Dallas',",
				"          Business_Name = 'Not available',",
				"          Also_Known_As = 'Not available',",
				"          License_Number = 0,",
				"          Facility_Type = 'Not available',",
				"          Risk = 'Not available',",
				"          Inspection_Results = 'Not available',",
				"          Violations = 'Not available',",
				"          Outcome_Category = 'Not available',",
				"          Single_Violation_Entry = 'Not available',",
				"          Address = 'Not available',",
				"          Geo_Missing = 'Not available',",
				"          InspectioID = 0) ~> derivedColumnDallas",
				"derivedColumnDallas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RECORDID as decimal(38,0),",
				"          INSPECTION_ID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          BUSINESS_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_RESULTS as string,",
				"          OUTCOME_CATEGORY as string,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          STREET_ADDRESS as string,",
				"          ADDRESS as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          LOCATION_MISSING as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          VIOLATIONS as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          SOURCE_CITY as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     stageInsert: true,",
				"     mapColumn(",
				"          RECORDID = RecordID,",
				"          INSPECTION_ID = InspectioID,",
				"          RESTAURANT_NAME = Restaurant_Name,",
				"          BUSINESS_NAME = Business_Name,",
				"          ALSO_KNOWN_AS = Also_Known_As,",
				"          LICENSE_NUMBER = License_Number,",
				"          FACILITY_TYPE = Facility_Type,",
				"          RISK = Risk,",
				"          INSPECTION_YEAR = Inspection_Year,",
				"          INSPECTION_TYPE = Inspection_Type,",
				"          INSPECTION_SCORE = Inspection_Score,",
				"          INSPECTION_DATE = Inspection_Date,",
				"          INSPECTION_RESULTS = Inspection_Results,",
				"          OUTCOME_CATEGORY = Outcome_Category,",
				"          STREET_NUMBER = Street_Number,",
				"          STREET_NAME = Street_Name,",
				"          STREET_DIRECTION = Street_Direction,",
				"          STREET_UNIT = Street_Unit,",
				"          STREET_TYPE = Street_Type,",
				"          STREET_ADDRESS = Street_Address,",
				"          ADDRESS = Address,",
				"          ZIP_CODE = Zip_Code,",
				"          CITY = City,",
				"          STATE = State,",
				"          LATITUDE = Latitude,",
				"          LONGITUDE = Longitude,",
				"          LOCATION = Location_Missing,",
				"          LOCATION_MISSING = Location_Missing,",
				"          GEO_MISSING = Geo_Missing,",
				"          VIOLATION_COUNT = Violation_Count,",
				"          TOTAL_VIOLATION_POINTS = Total_Violation_Points,",
				"          VIOLATIONS = Violations,",
				"          SINGLE_VIOLATION_ENTRY = Single_Violation_Entry,",
				"          VIOLATION_DESCRIPTION = Violation_Description,",
				"          VIOLATION_NUMBER = Violation_Number,",
				"          SOURCE_CITY = sourcecity",
				"     )) ~> sink1"
			]
		}
	}
}