{
	"name": "Fact_FoodInspection",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "sourceStageChicago"
				},
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "sourceDimDallas"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Location",
						"type": "DatasetReference"
					},
					"name": "sourceDimLocation"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Violation",
						"type": "DatasetReference"
					},
					"name": "sourceDimViolation"
				},
				{
					"dataset": {
						"referenceName": "SFDIMRESTAURANT",
						"type": "DatasetReference"
					},
					"name": "sourceDimRestaurant"
				},
				{
					"dataset": {
						"referenceName": "SfDimDate",
						"type": "DatasetReference"
					},
					"name": "sourceDimDate"
				},
				{
					"dataset": {
						"referenceName": "SF_DIM_Inspection_Type",
						"type": "DatasetReference"
					},
					"name": "sourceInspection"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SF_FACT_INSPECTION",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "joinRestuarant"
				},
				{
					"name": "joinInspectionType"
				},
				{
					"name": "joinViolation"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "joinDate"
				},
				{
					"name": "joinloc"
				},
				{
					"name": "union1"
				},
				{
					"name": "surrogateKey2"
				},
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          STREET_ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceStageChicago",
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimDallas",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as string,",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimLocation",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimViolation",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          ZIPCODE as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimRestaurant",
				"source(output(",
				"          DATE_SK as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_MONTH as string,",
				"          INSPECTION_YEAR as decimal(38,0),",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimDate",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceInspection",
				"surrogateKey1, sourceDimRestaurant join(union1@RESTAURANT_NAME == sourceDimRestaurant@RESTAURANT_NAME",
				"     && union1@CITY == sourceDimRestaurant@CITY",
				"     && union1@STATE == sourceDimRestaurant@STATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinRestuarant",
				"joinDate, sourceDimDallas join(union1@INSPECTION_TYPE == sourceDimDallas@INSPECTION_TYPE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinInspectionType",
				"joinInspectionType, sourceDimViolation join(union1@VIOLATION_NUMBER == sourceDimViolation@VIOLATION_NUMBER,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinViolation",
				"joinViolation derive(DI_JOB_ID = uuid(),",
				"          DI_LOAD_DT = currentDate(),",
				"          Inspection_sk = rownum,",
				"          RESTAURANT_SK = RESTAURANT_SK,",
				"          DATE_SK = DATE_SK,",
				"          LOCATION_SK = LOCATION_SK,",
				"          INSPECTIONTYPE_SK = union1@INSPECTION_TYPE,",
				"          VIOLATION_SK = VIOLATION_SK,",
				"          VIOLATION_COUNT = union1@VIOLATION_COUNT,",
				"          rownum = rownum) ~> derivedColumn1",
				"union1 keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"joinloc, sourceDimDate join(union1@INSPECTION_DATE == sourceDimDate@INSPECTION_DATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinDate",
				"joinRestuarant, sourceDimLocation join(sourceDimRestaurant@ZIPCODE == sourceDimLocation@ZIPCODE",
				"     && union1@CITY == sourceDimLocation@CITY",
				"     && union1@STATE == sourceDimLocation@STATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinloc",
				"sourceStageChicago, sourceDimDallas union(byName: true)~> union1",
				"derivedColumn1 keyGenerate(output(row as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey2",
				"derivedColumn2 select(mapColumn(",
				"          RESTAURANT_SK,",
				"          VIOLATION_COUNT,",
				"          INSPECTIONTYPE_SK,",
				"          LOCATION_SK,",
				"          DATE_SK,",
				"          VIOLATION_SK,",
				"          CITY,",
				"          STATE,",
				"          row,",
				"          DI_JOB_ID,",
				"          DI_LOAD_DT",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"surrogateKey2 derive(DI_JOB_ID = uuid(),",
				"          DI_LOAD_DT = currentTimestamp()) ~> derivedColumn2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          INSPECTION_SK as decimal(38,0),",
				"          RESTAURANT_SK as decimal(38,0),",
				"          DATE_SK as decimal(38,0),",
				"          LOCATION_SK as decimal(38,0),",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     stageInsert: true,",
				"     mapColumn(",
				"          INSPECTION_SK = row,",
				"          RESTAURANT_SK,",
				"          DATE_SK,",
				"          LOCATION_SK,",
				"          INSPECTIONTYPE_SK,",
				"          VIOLATION_SK,",
				"          VIOLATION_COUNT,",
				"          CITY,",
				"          STATE,",
				"          DI_JOB_ID,",
				"          DI_LOAD_DATE = DI_LOAD_DT",
				"     )) ~> sink1"
			]
		}
	}
}