{
	"name": "Fact_FoodInspection",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "SF_DIM_Inspection_Type",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Location",
						"type": "DatasetReference"
					},
					"name": "source4"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Violation",
						"type": "DatasetReference"
					},
					"name": "source5"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "DerivedChicago"
				},
				{
					"name": "DerivedDallas"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          BUSINESS_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> source1",
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> source2",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> source3",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as string,",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> source4",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> source5",
				"source1 derive(DI_JOB_ID = \"ChicagoJob\") ~> DerivedChicago",
				"source2 derive(DI_JOB_ID = \"DallasJob\") ~> DerivedDallas",
				"DerivedChicago, DerivedDallas union(byName: true)~> union1",
				"union1 derive(DI_LOAD_DATE = currentDate()) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          INSPECTION_ID,",
				"          BUSINESS_NAME,",
				"          ALSO_KNOWN_AS,",
				"          LICENSE_NUMBER,",
				"          FACILITY_TYPE,",
				"          RISK,",
				"          ADDRESS,",
				"          CITY,",
				"          STATE,",
				"          ZIP_CODE,",
				"          INSPECTION_DATE,",
				"          INSPECTION_TYPE,",
				"          INSPECTION_RESULTS,",
				"          VIOLATIONS,",
				"          LATITUDE,",
				"          LONGITUDE,",
				"          LOCATION,",
				"          GEO_MISSING,",
				"          VIOLATION_COUNT,",
				"          OUTCOME_CATEGORY,",
				"          SINGLE_VIOLATION_ENTRY,",
				"          VIOLATION_DESCRIPTION,",
				"          VIOLATION_NUMBER,",
				"          DI_JOB_ID,",
				"          RECORDID,",
				"          RESTAURANT_NAME,",
				"          INSPECTION_YEAR,",
				"          INSPECTION_SCORE,",
				"          STREET_NUMBER,",
				"          STREET_NAME,",
				"          STREET_DIRECTION,",
				"          STREET_ADDRESS,",
				"          STREET_UNIT,",
				"          STREET_TYPE,",
				"          TOTAL_VIOLATION_POINTS,",
				"          LOCATION_MISSING,",
				"          DI_LOAD_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}