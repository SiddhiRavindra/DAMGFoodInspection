{
	"name": "Fact_FoodInspection",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ChicagoSFSink",
						"type": "DatasetReference"
					},
					"name": "sourceStageChicago"
				},
				{
					"dataset": {
						"referenceName": "SF_DIM_Inspection_Type",
						"type": "DatasetReference"
					},
					"name": "sourceDimInspectionType"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Location",
						"type": "DatasetReference"
					},
					"name": "sourceDimLocation"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Violation",
						"type": "DatasetReference"
					},
					"name": "sourceDimViolation"
				},
				{
					"dataset": {
						"referenceName": "SFDIMRESTAURANT",
						"type": "DatasetReference"
					},
					"name": "sourceDimRestaurant"
				},
				{
					"dataset": {
						"referenceName": "SfDimDate",
						"type": "DatasetReference"
					},
					"name": "sourceDimDate"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SF_FACT_INSPECTION",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "DerivedChicago"
				},
				{
					"name": "joinRestuarant"
				},
				{
					"name": "joinInspectionType"
				},
				{
					"name": "joinViolation"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "select1"
				},
				{
					"name": "surrogateKeyLoaction"
				},
				{
					"name": "joinDate"
				},
				{
					"name": "surrogateKey2"
				},
				{
					"name": "joinloc"
				}
			],
			"scriptLines": [
				"source(output(",
				"          INSPECTION_ID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          ALSO_KNOWN_AS as string,",
				"          LICENSE_NUMBER as decimal(38,0),",
				"          FACILITY_TYPE as string,",
				"          RISK as string,",
				"          STREET_ADDRESS as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_RESULTS as string,",
				"          VIOLATIONS as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          LOCATION as string,",
				"          GEO_MISSING as string,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          OUTCOME_CATEGORY as string,",
				"          SINGLE_VIOLATION_ENTRY as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceStageChicago",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimInspectionType",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as string,",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimLocation",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimViolation",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          ZIPCODE as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimRestaurant",
				"source(output(",
				"          DATE_SK as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_MONTH as string,",
				"          INSPECTION_YEAR as decimal(38,0),",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourceDimDate",
				"sourceStageChicago derive(DI_JOB_ID = \"ChicagoJob\") ~> DerivedChicago",
				"surrogateKey2, sourceDimRestaurant join(sourceStageChicago@RESTAURANT_NAME == sourceDimRestaurant@RESTAURANT_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinRestuarant",
				"joinDate, sourceDimInspectionType join(sourceStageChicago@INSPECTION_TYPE == sourceDimInspectionType@INSPECTION_TYPE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinInspectionType",
				"joinInspectionType, sourceDimViolation join(sourceStageChicago@VIOLATION_NUMBER == sourceDimViolation@VIOLATION_NUMBER,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinViolation",
				"joinViolation derive(DI_JOB_ID = uuid(),",
				"          DI_LOAD_DT = currentDate(),",
				"          Inspection_sk = rownum,",
				"          RESTAURANT_SK = RESTAURANT_SK,",
				"          DATE_SK = DATE_SK,",
				"          LOCATION_SK = LOCATION_SK,",
				"          INSPECTIONTYPE_SK = INSPECTIONTYPE_SK,",
				"          VIOLATION_SK = VIOLATION_SK,",
				"          VIOLATION_COUNT = VIOLATION_COUNT) ~> derivedColumn1",
				"DerivedChicago keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"derivedColumn1 select(mapColumn(",
				"          CITY = sourceStageChicago@CITY,",
				"          STATE = sourceStageChicago@STATE,",
				"          VIOLATION_COUNT,",
				"          rownum,",
				"          RESTAURANT_SK,",
				"          DI_LOAD_DATE = sourceDimRestaurant@DI_LOAD_DATE,",
				"          DATE_SK,",
				"          LOCATION_SK,",
				"          INSPECTIONTYPE_SK,",
				"          VIOLATION_SK,",
				"          DI_LOAD_DT",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"surrogateKey1 keyGenerate(output(locationsk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKeyLoaction",
				"joinloc, sourceDimDate join(sourceStageChicago@INSPECTION_DATE == sourceDimDate@INSPECTION_DATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinDate",
				"surrogateKeyLoaction keyGenerate(output(violationsk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey2",
				"joinRestuarant, sourceDimLocation join(sourceDimRestaurant@ZIPCODE == sourceDimLocation@ZIPCODE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinloc",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          INSPECTION_SK as decimal(38,0),",
				"          RESTAURANT_SK as decimal(38,0),",
				"          DATE_SK as decimal(38,0),",
				"          LOCATION_SK as decimal(38,0),",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     stageInsert: true,",
				"     mapColumn(",
				"          RESTAURANT_SK,",
				"          DATE_SK,",
				"          LOCATION_SK,",
				"          INSPECTIONTYPE_SK,",
				"          VIOLATION_SK,",
				"          VIOLATION_COUNT,",
				"          CITY,",
				"          STATE,",
				"          DI_LOAD_DATE",
				"     )) ~> sink1"
			]
		}
	}
}