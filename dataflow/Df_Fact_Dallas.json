{
	"name": "Df_Fact_Dallas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DallasSFSink",
						"type": "DatasetReference"
					},
					"name": "sourcedallas"
				},
				{
					"dataset": {
						"referenceName": "SFDIMRESTAURANT",
						"type": "DatasetReference"
					},
					"name": "sourcedimrestaurant"
				},
				{
					"dataset": {
						"referenceName": "SfDimDate",
						"type": "DatasetReference"
					},
					"name": "sourcedate"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Location",
						"type": "DatasetReference"
					},
					"name": "sourcedimlocation"
				},
				{
					"dataset": {
						"referenceName": "SF_DIM_Inspection_Type",
						"type": "DatasetReference"
					},
					"name": "sourcediminspection"
				},
				{
					"dataset": {
						"referenceName": "SF_Dim_Violation",
						"type": "DatasetReference"
					},
					"name": "sourcedimviolation"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "DerivedDallas"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "joinrestaurant"
				},
				{
					"name": "joindate"
				},
				{
					"name": "joinlocation"
				},
				{
					"name": "joininspectiontype"
				},
				{
					"name": "joinviolation"
				}
			],
			"scriptLines": [
				"source(output(",
				"          RECORDID as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          INSPECTION_YEAR as string,",
				"          INSPECTION_TYPE as string,",
				"          INSPECTION_SCORE as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          STREET_NUMBER as decimal(38,0),",
				"          STREET_NAME as string,",
				"          STREET_DIRECTION as string,",
				"          STREET_ADDRESS as string,",
				"          STREET_UNIT as string,",
				"          STREET_TYPE as string,",
				"          ZIP_CODE as decimal(38,0),",
				"          CITY as string,",
				"          STATE as string,",
				"          LATITUDE as double,",
				"          LONGITUDE as double,",
				"          VIOLATION_COUNT as decimal(38,0),",
				"          TOTAL_VIOLATION_POINTS as decimal(38,0),",
				"          LOCATION_MISSING as string,",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_NUMBER as decimal(38,0)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedallas",
				"source(output(",
				"          RESTAURANT_SK as decimal(38,0),",
				"          RESTAURANT_NAME as string,",
				"          STREET_ADDRESS as string,",
				"          ZIPCODE as string,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimrestaurant",
				"source(output(",
				"          DATE_SK as decimal(38,0),",
				"          INSPECTION_DATE as date,",
				"          INSPECTION_MONTH as string,",
				"          INSPECTION_YEAR as decimal(38,0),",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedate",
				"source(output(",
				"          LOCATION_SK as decimal(38,0),",
				"          ZIPCODE as decimal(38,0),",
				"          LONGITUDE as double,",
				"          LATITUDE as double,",
				"          CITY as string,",
				"          STATE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimlocation",
				"source(output(",
				"          INSPECTIONTYPE_SK as decimal(38,0),",
				"          INSPECTION_TYPE as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcediminspection",
				"source(output(",
				"          VIOLATION_SK as decimal(38,0),",
				"          VIOLATION_NUMBER as decimal(38,0),",
				"          VIOLATION_DESCRIPTION as string,",
				"          DI_JOB_ID as string,",
				"          DI_LOAD_DATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table') ~> sourcedimviolation",
				"sourcedallas derive(DI_JOB_ID = \"DallasJob\") ~> DerivedDallas",
				"DerivedDallas keyGenerate(output(rownum as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1, sourcedimrestaurant join(sourcedallas@RESTAURANT_NAME == sourcedimrestaurant@RESTAURANT_NAME,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinrestaurant",
				"joinrestaurant, sourcedate join(sourcedallas@INSPECTION_DATE == sourcedate@INSPECTION_DATE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joindate",
				"joindate, sourcedimlocation join(ZIP_CODE == sourcedimlocation@ZIPCODE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinlocation",
				"joinlocation, sourcediminspection join(sourcedallas@INSPECTION_TYPE == sourcediminspection@INSPECTION_TYPE,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joininspectiontype",
				"joininspectiontype, sourcedimviolation join(sourcedallas@VIOLATION_NUMBER == sourcedimviolation@VIOLATION_NUMBER,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinviolation"
			]
		}
	}
}